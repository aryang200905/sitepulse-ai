# ────────────────────────────────────────────────────────
#  SitePulse AI — Environment Variables
# ────────────────────────────────────────────────────────

# ── Firebase (required for auth) ──
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef

# ── LLM enhancement (OPTIONAL) ──
# The full SEO + AEO analysis works with ZERO keys — it is deterministic and
# grounded in the real page. Adding a key upgrades the AEO Pack and drafts from
# "extracted from your page" to "AI-written from your page content".
#
# Provider-agnostic: works with any OpenAI-compatible endpoint, or Anthropic.
# Leave unset to run fully deterministic.

# OpenAI (default):
# LLM_API_KEY=sk-your-key-here
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini

# Anthropic (auto-detected from the URL / key):
# LLM_API_KEY=sk-ant-your-key-here
# LLM_API_URL=https://api.anthropic.com/v1/messages
# LLM_MODEL=claude-sonnet-4-5

# ── Scraping / anti-bot (OPTIONAL but recommended) ──
# Without a provider, SitePulse fetches pages directly with realistic browser
# headers — which works for most sites but not ones behind bot protection
# (Cloudflare, Akamai, etc.). Configure ONE provider to render protected sites
# with a real headless browser. Truly hardened sites (CAPTCHA/Turnstile) may
# still block — we never solve CAPTCHAs.
#
# Option A — Cloudflare Browser Rendering (headless Chrome on Cloudflare's edge):
#   Create an API token with the "Browser Rendering — Edit" permission.
# SCRAPE_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-browser-rendering-token
#
# Option B — Firecrawl (managed scraping w/ browser emulation + proxies):
# SCRAPE_PROVIDER=firecrawl
# FIRECRAWL_API_KEY=fc-your-key-here
#
# Optional: render every page through the provider (slower, higher success):
# SCRAPE_STRATEGY=render-first
